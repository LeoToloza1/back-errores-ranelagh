extends layout

block title-area
    h1 Dashboard
    p Bienvenido, #{nombreUsuario}

block content
    //- Tarjetas de Indicadores (KPIs)
    section.kpi-grid
        .kpi-card
            .kpi-icon.blue: i.bi.bi-list-check
            .kpi-data
                span.kpi-value #{errors.length}
                span.kpi-label Total Errores
        .kpi-card
            .kpi-icon.green: i.bi.bi-person-check
            .kpi-data
                span.kpi-value #{personal.length}
                span.kpi-label Personal Activo

    //- Filtros
    section.content-card
        .card-header
            h2 Filtros de Búsqueda
        form.filter-grid(action="/admin" method="GET")
            .field
                label Responsable
                input(type="text" name="responsable" value=responsable placeholder="Nombre...")
            .field
                label Desde
                input(type="date" name="fechaDesde" value=fechaDesde)
            .field
                label Hasta
                input(type="date" name="fechaHasta" value=fechaHasta)
            .field.btn-area
                button.btn-search(type="submit") Aplicar Filtros

    //- Tu tabla separada
    include ./tablaErrores