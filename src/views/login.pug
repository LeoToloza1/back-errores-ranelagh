doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Login - Panel de Admin
        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&display=swap")
        link(rel="stylesheet" href="/css/styles.css")
        script(type="module" defer src="/js/login.js")

    body.login-page
        main.login-card
            header
                h1 Iniciar Sesión

            section
                form#loginForm.login-form
                    .field
                        label(for="username") Usuario
                        input(type="text" id="username" name="username" required placeholder="Tu usuario")

                    .field
                        label(for="password") Contraseña
                        input(type="password" id="password" name="password" required placeholder="••••••••")

                    button.btn-login(type="submit") Entrar al Panel

                if error
                    p.error(style="color: #ef4444; font-size: 0.85rem; margin-top: 1rem; text-align: center;")= error
                p#message(style="text-align: center; font-size: 0.85rem; margin-top: 1rem;")

        footer(style="margin-top: 2rem; color: rgba(255,255,255,0.5); font-size: 0.75rem;")
